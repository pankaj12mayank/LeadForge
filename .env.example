# Copy to:  .env  and/or  scraper.env  (same folder as lead_scraper.py)
# Load order: .env first, then scraper.env (later file overrides).
# Use scraper.env if ".env" is hard to see in your file explorer.

# --- Chrome (attach = you log in + set People search; recommended) ---
ATTACH_EXISTING_CHROME=1
REMOTE_DEBUG_PORT=9222
# CHROME_USER_DATA_DIR=D:\selenium\li_profile
# START_URL=https://www.linkedin.com/search/results/people/

# --- Scrape: how many profiles ---
MAX_LEADS=20
MAX_LEADS_CAP=500
ASK_MAX_LEADS=0
# SCROLL_ROUNDS_PER_PAGE=4
# MAX_SEARCH_PAGES=8
# MAX_EXTRA_TABS=1
# MAX_BROWSER_TABS=3

# --- Delays (seconds, random min–max) ---
DELAY_MIN=4
DELAY_MAX=9

# --- Output (Excel) ---
LEADS_FILE=linkedin_leads.xlsx

# --- AI (Problem + Solution: ollama | api | none) ---
AI_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# SOLUTION_AI_BACKEND=ollama

# --- Run checks (0 = on; 1 = skip — not recommended) ---
SKIP_PREFLIGHT=0
# PROXY_URL=http://host:port

# --- Optional: push leads to your HTTP API ---
# LNN_BASE_URL=http://127.0.0.1:8000
# LNN_API_TOKEN=
# LNN_IS_ADMIN=0
# LNN_WORKSPACE_ID=1
# LNN_PUSH=0

# --- LeadPilot (scrape + Apollo/Skrapp + score). Use: python leadpilot_single.py --help
# ENRICHMENT_ENABLED=1
# APOLLO_API_KEY=
# APOLLO_BASE_URL=https://api.apollo.io
# SKRAPP_API_KEY=
# SCORING_USE_GPT=0
# SCORING_GPT_SCORE=0
# LEADPILOT_OUT_XLSX=leadpilot_runs.xlsx
# LEADPILOT_TEST=0
# LEADPILOT_PREFLIGHT=1
